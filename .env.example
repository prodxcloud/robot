# ─────────────────────────────────────────────────────────────────────────────
#  robot — configuration
#
#  Note what is NOT here: no AWS_ACCESS_KEY_ID, no ARM_CLIENT_SECRET, no
#  GOOGLE_APPLICATION_CREDENTIALS. The robot holds no cloud credentials because
#  it does no provisioning. It asks its vxnode node, and the node holds them.
# ─────────────────────────────────────────────────────────────────────────────

# ── vxnode: the only route to infrastructure ────────────────────────────────
# The node listens on loopback inside its VM; nginx fronts it with TLS for
# external callers. Point this at whichever node backs this robot.
VXNODE_URL=http://127.0.0.1:8744
VXNODE_API_KEY=
VXNODE_ID=default
VXNODE_TENANT=
VXNODE_TIMEOUT_MS=30000

# Set to 1 to print the exact call the robot *would* make to the node, without
# sending it. Worth doing before letting an autonomous plan touch real infra.
VXNODE_DRY_RUN=0

# ── Brain ───────────────────────────────────────────────────────────────────
ROBOT_BRAIN_CSV=datasets/brain/robot_brain.csv

# ── Logging ─────────────────────────────────────────────────────────────────
ROBOT_DEBUG=

# ── Optional: LLM providers ─────────────────────────────────────────────────
# The brain works fully offline. These only enable the optional LLM layer in
# src/ai, which paraphrases and handles what the corpus misses.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434
