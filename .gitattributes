# Keep LF in the working tree. Cloned on Windows without this, every source file
# picks up CRLF, which breaks shebang lines in the shell scripts, confuses
# clang-format into reporting the whole tree as unformatted, and shows up as a
# spurious whole-file diff the first time anyone edits.
* text=auto eol=lf

*.cpp  text eol=lf
*.hpp  text eol=lf
*.h    text eol=lf
*.txt  text eol=lf
*.cmake text eol=lf
*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.proto text eol=lf
*.conf text eol=lf
*.csv  text eol=lf
*.md   text eol=lf
Dockerfile text eol=lf

# Build output, should it ever be staged by accident.
*.exe binary
*.so  binary
*.a   binary
*.o   binary
